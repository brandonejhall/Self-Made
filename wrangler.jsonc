// Cloudflare Workers deploy config. Static site only: no Worker script, no backend.
// `npm run build` writes dist/, then `npx wrangler deploy` uploads it.
{
  "name": "self-made",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
